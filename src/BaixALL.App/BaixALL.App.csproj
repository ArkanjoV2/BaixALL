<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>BaixALL</AssemblyName>
    <RootNamespace>BaixALL.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>BaixALL</Product>
    <Description>Aplicativo desktop para download de vídeos do YouTube com yt-dlp e FFmpeg</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
