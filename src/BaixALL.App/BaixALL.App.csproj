<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>BaixALL</AssemblyName>
    <RootNamespace>BaixALL.App</RootNamespace>
    <Version>1.0.0-rc.2</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.2</InformationalVersion>
    <Product>BaixALL</Product>
    <Company>BaixALL</Company>
    <Authors>BaixALL Team</Authors>
    <Copyright>Copyright © 2026 BaixALL</Copyright>
    <Description>Aplicativo desktop para download de vídeos do YouTube com yt-dlp e FFmpeg</Description>
    <PackageProjectUrl>https://github.com/BaixALL/BaixALL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BaixALL/BaixALL</RepositoryUrl>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
