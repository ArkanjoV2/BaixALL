<UserControl x:Class="BaixALL.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Histórico de Downloads" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Registro local dos vídeos e áudios baixados. Limpar o histórico não exclui os arquivos do disco."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Limpar Histórico"
                    Command="{Binding ClearAllCommand}" VerticalAlignment="Center"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Estado Vazio -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="40,30" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Nenhum download registrado ainda" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Os vídeos concluídos aparecerão aqui para fácil acesso posterior."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Lista de Histórico -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Quality}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Format}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding FinalFilePath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Ações -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Abrir"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />

                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Pasta"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />

                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="✕"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="10,6" FontSize="12" ToolTip="Remover do histórico" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
