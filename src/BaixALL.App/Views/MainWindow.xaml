<Window x:Class="BaixALL.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BaixALL.App.Views"
        mc:Ignorable="d"
        Title="BaixALL - Download de Vídeos do YouTube"
        Height="780" Width="1080"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header / Barra de Navegação -->
            <RowDefinition Height="64" />
            <!-- 1: Barra de Notificação Global -->
            <RowDefinition Height="Auto" />
            <!-- 2: Conteúdo Principal / Abas -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER DA APLICAÇÃO -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo e Nome do Aplicativo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconBaixAll}" Fill="{DynamicResource AccentTextBrush}"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BaixALL" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Abas de Navegação -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Aba Início / Baixar -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="Início"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Downloader">
                        <Button.Triggers>
                            <!-- Visual State gerenciado pelo estilo -->
                        </Button.Triggers>
                    </Button>

                    <!-- Aba Fila de Downloads -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Queue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fila de Downloads" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentBrush}" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ActiveDownloadsCount, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ActiveDownloadsCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Aba Histórico -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="Histórico"
                            Command="{Binding SwitchTabCommand}" CommandParameter="History" />

                    <!-- Aba Ferramentas -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="Ferramentas"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Dependencies" />

                    <!-- Aba Configurações -->
                    <Button Style="{StaticResource NavButtonStyle}" Content="Configurações"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Settings" />
                </StackPanel>

                <!-- Indicador de Status das Ferramentas no Canto Superior -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A107C41" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DependenciesReady}" Value="False">
                                        <Setter Property="Background" Value="#1AD97706" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="● Ferramentas Prontas" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DependenciesReady}" Value="False">
                                            <Setter Property="Text" Value="▲ Ferramentas Pendentes" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BANNER DE NOTIFICAÇÃO GLOBAL -->
        <Border Grid.Row="1" Visibility="{Binding HasStatusNotification, Converter={StaticResource BoolToVis}}"
                Padding="16,10" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#220078D4" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusType}" Value="Success">
                            <Setter Property="Background" Value="#22107C41" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusType}" Value="Warning">
                            <Setter Property="Background" Value="#22D97706" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusType}" Value="Error">
                            <Setter Property="Background" Value="#22D83B01" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusNotification}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="✕" Padding="6,2"
                        Command="{Binding ClearNotificationCommand}" BorderThickness="0" Background="Transparent" />
            </Grid>
        </Border>

        <!-- ÁREA DE CONTEÚDO PRINCIPAL (COM ABAS) -->
        <Grid Grid.Row="2">

            <!-- 1. ABA DOWNLOADER (INÍCIO) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Downloader">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Margin="32" MaxWidth="860" HorizontalAlignment="Stretch">
                    
                    <!-- Seção Hero -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,28">
                        <TextBlock Text="Baixe seus vídeos" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Na melhor qualidade disponível original do YouTube"
                                   FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- BARRA DE ENTRADA DA URL - ÚNICO ELEMENTO COM CANTOS ARREDONDADOS (CornerRadius="8") -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Caixa de URL com cantos arredondados exclusivos -->
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource UrlInputTextBoxStyle}"
                                     Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" />

                            <!-- Botão Colar -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Colar"
                                    Command="{Binding PasteAndAnalyzeCommand}"
                                    Margin="0,0,10,0"
                                    Padding="14,10" />

                            <!-- Botão Analisar -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Analisar"
                                    Command="{Binding AnalyzeCommand}"
                                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBool}}"
                                    Padding="24,10" />
                        </Grid>
                    </Border>

                    <!-- INDICADOR DE ANÁLISE EM ANDAMENTO -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="20"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="4" Width="300" Margin="0,0,0,12" />
                            <TextBlock Text="Analisando metadados e formatos disponíveis no YouTube..."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- CARD DE METADADOS DO VÍDEO ANALISADO -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24"
                            Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Informações do Vídeo (Thumbnail + Detalhes) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Background="#11000000" Height="125" Width="220" Margin="0,0,20,0" VerticalAlignment="Top">
                                    <Image Source="{Binding VideoInfo.ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Metadados -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding VideoInfo.Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding VideoInfo.Channel}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding VideoInfo.FormattedDuration, StringFormat='⏱ {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding VideoInfo.UploadDate, StringFormat='📅 {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                    </StackPanel>

                                    <!-- Tags de Qualidade Máxima e FPS -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding VideoInfo.MaxResolution, StringFormat='Máx: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3"
                                                Visibility="{Binding VideoInfo.FormattedFps, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding VideoInfo.FormattedFps}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,0,0,20" />

                            <!-- Configuração de Download para este Vídeo -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Seleção de Qualidade -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Qualidade do Vídeo" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAudioOnlyMode, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="{Binding SelectedFormat.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Formato / Container -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Formato / Container" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding ContainerOptions}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAudioOnlyMode, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="Automático preserva a qualidade sem recodificar" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Modo Somente Áudio -->
                            <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="Baixar somente o áudio do vídeo"
                                              IsChecked="{Binding IsAudioOnlyMode, Mode=TwoWay}"
                                              FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                    <Grid Visibility="{Binding IsAudioOnlyMode, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Formato de áudio:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AudioFormatOptions}" SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Pasta de Destino -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Salvar em" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DestinationFolder, Mode=TwoWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Escolher pasta"
                                            Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- BOTÃO PRINCIPAL: BAIXAR -->
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding StartDownloadCommand}"
                                    Padding="0,14" FontSize="16" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconDownload}" Fill="{DynamicResource AccentTextBrush}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Baixar Agora" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 2. ABA FILA DE DOWNLOADS -->
            <Grid Margin="32">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Queue">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho da Fila -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fila de Downloads" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Acompanhe o progresso em tempo real, velocidade e mesclagem de arquivos."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Limpar Concluídos"
                            Command="{Binding ClearCompletedQueueCommand}" VerticalAlignment="Center" />
                </Grid>

                <!-- Estado Vazio da Fila -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="40,30"
                        Visibility="{Binding QueueItems.Count, Converter={StaticResource InverseNullToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Nenhum download na fila" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Cole uma URL na aba Início e clique em 'Baixar' para iniciar."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Lista de Itens da Fila -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding QueueItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Linha 1: Título, Tags e Botões -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Quality}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2">
                                                        <TextBlock Text="{Binding Format}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ações no Item -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <!-- Botão Cancelar (Quando ativo) -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancelar"
                                                        Command="{Binding CancelCommand}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" />

                                                <!-- Botão Abrir Arquivo (Quando concluído) -->
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Abrir Arquivo"
                                                        Command="{Binding OpenFileCommand}"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" />

                                                <!-- Botão Abrir Pasta (Quando concluído) -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir Pasta"
                                                        Command="{Binding OpenFolderCommand}"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" />

                                                <!-- Botão Remover da Fila -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Remover da lista" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Linha 2: Barra de Progresso -->
                                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Margin="0,0,0,8" />

                                        <!-- Linha 3: Métricas (Status, Porcentagem, Velocidade, Tamanho, ETA) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status com indicador colorido -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="● " Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Detalhes de Progresso e Velocidade -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Porcentagem -->
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                                                           FontWeight="Bold" FontSize="13" Margin="0,0,16,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                                <!-- Tamanho Baixado / Total -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DownloadedSizeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Text=" / " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding TotalSizeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                </StackPanel>

                                                <!-- Velocidade -->
                                                <TextBlock Text="{Binding SpeedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                                <!-- ETA -->
                                                <TextBlock Text="{Binding EtaText, StringFormat='ETA: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 3. ABA HISTÓRICO -->
            <views:HistoryView DataContext="{Binding HistoryVm}">
                <views:HistoryView.Style>
                    <Style TargetType="views:HistoryView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="History">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HistoryView.Style>
            </views:HistoryView>

            <!-- 4. ABA FERRAMENTAS / DEPENDÊNCIAS -->
            <views:DependenciesView DataContext="{Binding DependenciesVm}">
                <views:DependenciesView.Style>
                    <Style TargetType="views:DependenciesView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Dependencies">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DependenciesView.Style>
            </views:DependenciesView>

            <!-- 5. ABA CONFIGURAÇÕES -->
            <views:SettingsView DataContext="{Binding SettingsVm}">
                <views:SettingsView.Style>
                    <Style TargetType="views:SettingsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsView.Style>
            </views:SettingsView>

        </Grid>
    </Grid>
</Window>
