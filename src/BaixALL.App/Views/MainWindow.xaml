<Window x:Class="BaixALL.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BaixALL.App.Views"
        mc:Ignorable="d"
        Title="BaixALL - Download de Vídeos Multiplataforma"
        Icon="pack://application:,,,/BaixALL;component/Resources/icon.ico"
        Height="780" Width="1080"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <!-- 0: Header / Barra de Navegação -->
            <RowDefinition Height="64" />
            <!-- 1: Barra de Notificação Global -->
            <RowDefinition Height="Auto" />
            <!-- 2: Conteúdo Principal / Abas -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER DA APLICAÇÃO REFINADO COM DEGRADÊ E SOMBRA DISCRETA -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.32" />
            </Border.Effect>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo e Nome do Aplicativo: 'Baix' Branco + 'ALL' Azul Tech -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Margin="0,0,10,0"
                            Background="#111724"
                            BorderBrush="{DynamicResource HeaderBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="22" Height="22" SnapsToDevicePixels="True">
                            <Path Data="{StaticResource IconBaixAll}" Fill="{DynamicResource BrandAccentBrush}"
                                  Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Baix"
                                   FontFamily="{StaticResource BrandFontFamily}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource HeaderTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="ALL"
                                   FontFamily="{StaticResource BrandFontFamily}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource BrandAccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Abas de Navegação com Indicador de Estado Ativo e Alto Contraste -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Aba Início / Baixar -->
                    <Button Style="{StaticResource NavHomeButtonStyle}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Downloader">
                        <TextBlock Text="Início" VerticalAlignment="Center" />
                    </Button>

                    <!-- Aba Fila de Downloads -->
                    <Button Style="{StaticResource NavQueueButtonStyle}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Queue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fila de Downloads" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentBrush}" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="0"
                                    Visibility="{Binding ActiveDownloadsCount, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ActiveDownloadsCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Aba Histórico -->
                    <Button Style="{StaticResource NavHistoryButtonStyle}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="History">
                        <TextBlock Text="Histórico" VerticalAlignment="Center" />
                    </Button>

                    <!-- Aba Ferramentas -->
                    <Button Style="{StaticResource NavToolsButtonStyle}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Dependencies">
                        <TextBlock Text="Ferramentas" VerticalAlignment="Center" />
                    </Button>

                    <!-- Aba Configurações -->
                    <Button Style="{StaticResource NavSettingsButtonStyle}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Settings">
                        <TextBlock Text="Configurações" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Indicador de Status das Ferramentas no Canto Superior - CLICÁVEL -->
                <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}"
                        Command="{Binding OpenToolsCommand}"
                        Padding="2" VerticalAlignment="Center"
                        ToolTip="Clique para abrir o Gerenciador de Ferramentas">
                    <Border Padding="8,4" CornerRadius="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A107C41" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DependenciesReady}" Value="False">
                                        <Setter Property="Background" Value="#1AD97706" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="● Ferramentas Prontas" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DependenciesReady}" Value="False">
                                            <Setter Property="Text" Value="▲ Ferramentas Pendentes" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- BANNER DE NOTIFICAÇÃO GLOBAL -->
        <Border Grid.Row="1" Visibility="{Binding HasStatusNotification, Converter={StaticResource BoolToVis}}"
                Padding="16,10" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#220078D4" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusType}" Value="Success">
                            <Setter Property="Background" Value="#22107C41" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusType}" Value="Warning">
                            <Setter Property="Background" Value="#22D97706" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusType}" Value="Error">
                            <Setter Property="Background" Value="#22D83B01" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusNotification}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />

                <!-- Ações no Banner: Configurar agora ou Tentar novamente -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Configurar agora"
                            Command="{Binding SetupNowCommand}"
                            Visibility="{Binding ShowSetupPrompt, Converter={StaticResource BoolToVis}}"
                            Padding="12,4" Margin="0,0,12,0" FontSize="12" />

                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Tentar novamente"
                            Command="{Binding AnalyzeCommand}"
                            Visibility="{Binding CanRetryAnalysis, Converter={StaticResource BoolToVis}}"
                            Padding="12,4" Margin="0,0,12,0" FontSize="12" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="✕" Padding="6,2"
                        Command="{Binding ClearNotificationCommand}" BorderThickness="0" Background="Transparent" />
            </Grid>
        </Border>

        <!-- ÁREA DE CONTEÚDO PRINCIPAL (COM ABAS) -->
        <Grid Grid.Row="2">

            <!-- 1. ABA DOWNLOADER (INÍCIO) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Downloader">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ELEMENTOS VETORIAIS DECORATIVOS NO PLANO DE FUNDO (WATERMARK CINZA AMPLIADO EM QUANTIDADE E ESCALA) -->
                <!-- IsHitTestVisible="False" garante 0 interferência com cliques, seleção ou rolagem -->
                <Grid IsHitTestVisible="False" Opacity="0.45" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <!-- Topo Esquerdo: Waveform Amplo, Play e Marcador de Keyframe -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,16,0,0">
                        <Path Data="{StaticResource DecorWaveform}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="2.0"
                              Stretch="Uniform" Width="230" Height="34" Margin="0,0,16,0" />
                        <Path Data="{StaticResource DecorPlay}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.8"
                              Stretch="Uniform" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorKeyframe}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="60" Height="28" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Topo Direito: Fotograma de Cinema, Download Chevron e Timeline Ampla -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,28,0">
                        <Path Data="{StaticResource DecorFilmStrip}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="54" Height="42" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorDownload}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="2.0"
                              Stretch="Uniform" Width="38" Height="38" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorTimeline}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="200" Height="36" />
                    </StackPanel>

                    <!-- Flanco Superior Esquerdo: Nota Musical e Equalizador -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,110,0,0">
                        <Path Data="{StaticResource DecorMusic}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.8"
                              Stretch="Uniform" Width="50" Height="50" Margin="0,0,0,14" />
                        <Path Data="{StaticResource DecorEqualizer}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="48" Height="40" />
                    </StackPanel>

                    <!-- Flanco Superior Direito: Equalizador e Play -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,20,0">
                        <Path Data="{StaticResource DecorEqualizer}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="48" Height="40" Margin="0,0,0,14" />
                        <Path Data="{StaticResource DecorPlay}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.8"
                              Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Flanco Inferior Esquerdo: Seta de Download e Waveform Médio -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,105">
                        <Path Data="{StaticResource DecorDownload}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.8"
                              Stretch="Uniform" Width="36" Height="36" Margin="0,0,0,12" />
                        <Path Data="{StaticResource DecorWaveform}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="160" Height="26" />
                    </StackPanel>

                    <!-- Flanco Inferior Direito: Nota Musical e Keyframe -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,105">
                        <Path Data="{StaticResource DecorMusic}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.8"
                              Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,12" />
                        <Path Data="{StaticResource DecorKeyframe}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="56" Height="26" />
                    </StackPanel>

                    <!-- Base Esquerda: Fotograma de Vídeo, Timeline de Edição e Play -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,20">
                        <Path Data="{StaticResource DecorFilmStrip}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="54" Height="42" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorTimeline}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="180" Height="34" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorPlay}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="28" Height="28" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Base Direita: Equalizador de Áudio, Seta Tecnológica e Timeline -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20">
                        <Path Data="{StaticResource DecorEqualizer}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="48" Height="40" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorDownload}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="2.0"
                              Stretch="Uniform" Width="38" Height="38" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource DecorTimeline}" Stroke="{DynamicResource HomeDecorBrush}" StrokeThickness="1.6"
                              Stretch="Uniform" Width="170" Height="34" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Conteúdo Funcional da Home (Rolável e Centrado) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32" MaxWidth="860" HorizontalAlignment="Stretch">
                    
                    <!-- Seção Hero -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,28">
                        <TextBlock Text="Baixe seus vídeos" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Na melhor qualidade disponível do YouTube, Instagram e X"
                                   FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- BARRA DE ENTRADA DA URL - ÚNICO ELEMENTO COM CANTOS ARREDONDADOS (CornerRadius="8") -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Caixa de URL com cantos arredondados exclusivos -->
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource UrlInputTextBoxStyle}"
                                     Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" />

                            <!-- Botão Colar -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Colar"
                                    Command="{Binding PasteAndAnalyzeCommand}"
                                    Margin="0,0,10,0"
                                    Padding="14,10" />

                            <!-- Botão Analisar (Texto Branco Garantido) -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AnalyzeCommand}"
                                    IsEnabled="{Binding CanAnalyze}"
                                    Padding="24,10"
                                    ToolTip="Cole o link do YouTube, Instagram ou X/Twitter para analisar as qualidades disponíveis">
                                <TextBlock Text="Analisar" Foreground="White" FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CARD DE ALERTA: CONFIGURE OS COMPONENTES PARA COMEÇAR (QUANDO PENDENTES) -->
                    <Border Style="{StaticResource CardBorderStyle}" Background="#160078D4" BorderBrush="{DynamicResource AccentBrush}"
                            Margin="0,0,0,24" Padding="16"
                            Visibility="{Binding ShowSetupPrompt, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Configure os componentes necessários para começar." FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="O BaixALL utiliza yt-dlp, FFmpeg e Deno para extrair e mesclar vídeos sem perda de qualidade. A instalação é 100% automática."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Configurar agora"
                                    Command="{Binding SetupNowCommand}" VerticalAlignment="Center" Padding="20,10" Margin="16,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- INDICADOR DE ANÁLISE EM ANDAMENTO -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="20"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="4" Width="300" Margin="0,0,0,12" />
                            <TextBlock Text="Analisando metadados e formatos disponíveis..."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancelar Análise"
                                    Command="{Binding CancelAnalysisCommand}" HorizontalAlignment="Center" Padding="16,6" />
                        </StackPanel>
                    </Border>

                    <!-- CARD DE METADADOS DO VÍDEO ANALISADO -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24"
                            Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- AVISO DE URL HÍBRIDA: VÍDEO PERTENCENTE A UMA PLAYLIST -->
                            <Border Background="#160078D4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,16"
                                    Visibility="{Binding IsHybridUrlDetected, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="💡 Este vídeo faz parte de uma playlist do YouTube" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Você pode baixar apenas este vídeo ou carregar todos os vídeos da playlist para download em lote."
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Carregar Playlist Completa"
                                            Command="{Binding LoadFullPlaylistFromHybridCommand}" VerticalAlignment="Center" Padding="14,8" FontSize="13" />
                                </Grid>
                            </Border>

                            <!-- Informações do Vídeo (Thumbnail + Detalhes) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Background="#11000000" Height="125" Width="220" Margin="0,0,20,0" VerticalAlignment="Top">
                                    <Image Source="{Binding VideoInfo.ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Metadados -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding VideoInfo.Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding VideoInfo.Channel}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding VideoInfo.FormattedDuration, StringFormat='⏱ {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding VideoInfo.UploadDate, StringFormat='📅 {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                    </StackPanel>

                                    <!-- Tags de Plataforma, Qualidade Máxima e FPS -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding VideoPlatformBackgroundColor}" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding VideoPlatformDisplayName}" FontWeight="Bold" FontSize="11" Foreground="{Binding VideoPlatformBadgeColor}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding VideoInfo.MaxResolution, StringFormat='Máx: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3"
                                                Visibility="{Binding VideoInfo.FormattedFps, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding VideoInfo.FormattedFps}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,0,0,20" />

                            <!-- Configuração de Download para este Vídeo -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Seleção de Qualidade -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Qualidade do Vídeo" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAudioOnlyMode, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="{Binding SelectedFormat.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Formato / Container -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Formato / Container" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding ContainerOptions}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAudioOnlyMode, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="Automático preserva a qualidade sem recodificar" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Modo Somente Áudio -->
                            <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="Baixar somente o áudio do vídeo"
                                              IsChecked="{Binding IsAudioOnlyMode, Mode=TwoWay}"
                                              FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                    <Grid Visibility="{Binding IsAudioOnlyMode, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Formato de áudio:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AudioFormatOptions}" SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Pasta de Destino -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Salvar em" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DestinationFolder, Mode=TwoWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Escolher pasta"
                                            Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- BOTÃO PRINCIPAL: BAIXAR -->
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="Baixar Agora"
                                    Command="{Binding StartDownloadCommand}"
                                    Padding="0,14" FontSize="16" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconDownload}" Fill="{DynamicResource AccentTextBrush}"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Baixar Agora" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CARD DE METADADOS DA PLAYLIST ANALISADA -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="20"
                            Visibility="{Binding HasPlaylistInfo, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Cabeçalho da Playlist (Thumbnail + Metadados) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail / Ícone da Playlist -->
                                <Border Grid.Column="0" Background="#11000000" Height="125" Width="220" Margin="0,0,20,0" VerticalAlignment="Top">
                                    <Grid>
                                        <Image Source="{Binding PlaylistInfo.ThumbnailUrl}" Stretch="UniformToFill" />
                                        <!-- Badge inferior com quantidade de vídeos -->
                                        <Border Background="#CC000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Padding="8,3">
                                            <TextBlock Text="{Binding PlaylistInfo.TotalVideosCount, StringFormat='{}{0} vídeos'}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Metadados -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{Binding PlaylistInfo.PlatformBackgroundColor}" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PlaylistInfo.CollectionTypeBadgeText}" FontWeight="Bold" FontSize="11" Foreground="{Binding PlaylistInfo.PlatformBadgeColor}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3">
                                            <TextBlock Text="{Binding PlaylistInfo.FormattedTotalDuration, StringFormat='Duração est.: ~{0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding PlaylistInfo.Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding PlaylistInfo.AuthorOrChannelLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding PlaylistInfo.TotalVideosCount, StringFormat='Total: {0} vídeos'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Barra de Ações em Lote e Seleção -->
                            <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Selecionar Todos"
                                                Command="{Binding SelectAllPlaylistItemsCommand}" Padding="10,5" Margin="0,0,8,0" FontSize="12" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Desmarcar Todos"
                                                Command="{Binding DeselectAllPlaylistItemsCommand}" Padding="10,5" Margin="0,0,8,0" FontSize="12" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Inverter Seleção"
                                                Command="{Binding InvertPlaylistSelectionCommand}" Padding="10,5" FontSize="12" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlaylistInfo.SelectionSummary}" FontWeight="Bold" Foreground="White" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Lista Rolável e Virtualizada de Vídeos da Playlist -->
                            <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" Margin="0,0,0,18" MaxHeight="280">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PlaylistItems}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checkbox de Seleção -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                        <!-- Índice -->
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedIndex}" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="12" />

                                                        <!-- Título e Canal -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Channel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding AvailabilityNotice}" Foreground="{DynamicResource WarningBrush}" FontSize="11"
                                                                           Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Duração -->
                                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Configurações de Download em Lote -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Qualidade Padrão do Lote -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Qualidade do Lote" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding BatchFormatOptions}" SelectedItem="{Binding SelectedBatchFormat, Mode=TwoWay}"
                                              IsEnabled="{Binding IsBatchAudioOnlyMode, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="{Binding SelectedBatchFormat.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Formato / Container -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Formato / Container" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding ContainerOptions}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                                              IsEnabled="{Binding IsBatchAudioOnlyMode, Converter={StaticResource InverseBool}}" />
                                    <TextBlock Text="Automático preserva a qualidade sem perda de compatibilidade" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Opções Avançadas de Lote: Somente Áudio e Subpasta -->
                            <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="Baixar somente o áudio de todos os vídeos da playlist"
                                              IsChecked="{Binding IsBatchAudioOnlyMode, Mode=TwoWay}"
                                              FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                    <Grid Visibility="{Binding IsBatchAudioOnlyMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Formato de áudio:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AudioFormatOptions}" SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}" />
                                    </Grid>

                                    <CheckBox Content="Criar subpasta com o nome da playlist para organizar os arquivos"
                                              IsChecked="{Binding CreatePlaylistSubfolder, Mode=TwoWay}"
                                              FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Pasta de Destino -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Salvar Lote em" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DestinationFolder, Mode=TwoWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Escolher pasta"
                                            Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- BOTÕES DE AÇÃO: LIMPAR E BAIXAR LOTE -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Content="← Limpar / Outra URL"
                                        Command="{Binding ClearPlaylistCommand}"
                                        Padding="16,12" FontSize="14" Margin="0,0,12,0" />

                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding EnqueueSelectedPlaylistItemsCommand}"
                                        Padding="0,14" FontSize="16" FontWeight="Bold">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconDownload}" Fill="{DynamicResource AccentTextBrush}"
                                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Adicionar Vídeos Selecionados à Fila" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ÁREA DE DOWNLOADS NA HOME (QUANDO NÃO HÁ VÍDEO EM ANÁLISE) -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,24" Padding="20"
                            Visibility="{Binding HasNoActiveContent, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Atividade de Download" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Ver Fila Completa"
                                        Command="{Binding SwitchTabCommand}" CommandParameter="Queue" Padding="12,5" FontSize="12" />
                            </Grid>

                            <!-- Seção de Fila Ativa se houver itens -->
                            <ItemsControl ItemsSource="{Binding QueueItems}" MaxHeight="300">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <Border Background="{Binding PlatformBackgroundColor}" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding PlatformDisplayName}" FontSize="10" FontWeight="Bold" Foreground="{Binding PlatformBadgeColor}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                        <TextBlock Text="{Binding Quality}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" FontSize="12" />
                                                    </StackPanel>
                                                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" Margin="0,2,0,0"
                                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Informação quando a fila estiver vazia -->
                            <TextBlock Text="Nenhum download em andamento. Cole a URL de um vídeo acima para começar."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,6,0,0"
                                       Visibility="{Binding QueueItems.Count, Converter={StaticResource InverseNullToVis}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 2. ABA FILA DE DOWNLOADS -->
            <Grid Margin="32">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Queue">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho da Fila -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fila de Downloads" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Acompanhe o progresso em tempo real, velocidade e mesclagem de arquivos."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Limpar Concluídos"
                            Command="{Binding ClearCompletedQueueCommand}" VerticalAlignment="Center" />
                </Grid>

                <!-- Estado Vazio da Fila -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="40,30"
                        Visibility="{Binding QueueItems.Count, Converter={StaticResource InverseNullToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Nenhum download na fila" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Cole uma URL na aba Início e clique em 'Baixar' para iniciar."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Lista de Itens da Fila -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PAINEL DE PROGRESSO AGREGADO DE LOTES EM ANDAMENTO -->
                        <ItemsControl ItemsSource="{Binding ActiveBatches}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="18"
                                            BorderBrush="{DynamicResource BrandAccentBrush}" BorderThickness="1.5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Linha 1: Título do Lote e Ações -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="{Binding PlatformBackgroundColor}" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PlatformDisplayName, StringFormat='LOTE {0}'}" FontSize="11" FontWeight="Bold" Foreground="{Binding PlatformBadgeColor}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding BatchStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding BatchTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ProgressSummaryText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Cancelar Lote"
                                                        Command="{Binding CancelCommand}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        VerticalAlignment="Center" Padding="14,6" />
                                            </Grid>

                                            <!-- Linha 2: Barra de Progresso Agregado Honesta por Itens -->
                                            <ProgressBar Grid.Row="1" Value="{Binding ItemsProgressPercentage, Mode=OneWay}"
                                                         Maximum="100" Height="8" Margin="0,0,0,10"
                                                         Foreground="{DynamicResource AccentBrush}" />

                                            <!-- Linha 3: Contadores Detalhados -->
                                            <WrapPanel Grid.Row="2">
                                                <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock Text="{Binding CompletedCount, StringFormat='Concluídos: {0}'}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,4"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ActiveCount, StringFormat='Baixando: {0}'}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock Text="{Binding QueuedCount, StringFormat='Aguardando: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,4"
                                                        Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding FailedCount, StringFormat='Falhas: {0}'}" FontSize="12" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="8,3" Margin="0,0,8,4"
                                                        Visibility="{Binding HasCanceled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding CanceledCount, StringFormat='Cancelados: {0}'}" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Itens Individuais da Fila -->
                        <ItemsControl ItemsSource="{Binding QueueItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Linha 1: Título, Tags e Botões -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="{Binding PlatformBackgroundColor}" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding PlatformDisplayName}" FontSize="11" FontWeight="Bold" Foreground="{Binding PlatformBadgeColor}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentBrush}" Padding="6,2" Margin="0,0,8,0"
                                                            Visibility="{Binding IsBatchItem, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding BatchBadgeText}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" Margin="0,0,8,0"
                                                            Visibility="{Binding IsBatchItem, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding BatchTitle, StringFormat='Origem: {0}'}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Quality}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2">
                                                        <TextBlock Text="{Binding Format}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ações no Item -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <!-- Botão Cancelar (Quando ativo) -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancelar"
                                                        Command="{Binding CancelCommand}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" />

                                                <!-- Botão Abrir Arquivo (Quando concluído) -->
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Abrir Arquivo"
                                                        Command="{Binding OpenFileCommand}"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" />

                                                <!-- Botão Abrir Pasta (Quando concluído) -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir Pasta"
                                                        Command="{Binding OpenFolderCommand}"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,8,0" />

                                                <!-- Botão Remover da Fila -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Remover da lista" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Linha 2: Barra de Progresso -->
                                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Margin="0,0,0,8" />

                                        <!-- Linha 3: Métricas (Status, Porcentagem, Velocidade, Tamanho, ETA) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status com indicador colorido -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="● " Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Detalhes de Progresso e Velocidade -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Porcentagem -->
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                                                           FontWeight="Bold" FontSize="13" Margin="0,0,16,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                                <!-- Tamanho Baixado / Total -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DownloadedSizeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Text=" / " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding TotalSizeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                </StackPanel>

                                                <!-- Tamanho Final Concluído -->
                                                <TextBlock Text="{Binding FormattedFinalFileSize}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"
                                                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />

                                                <!-- Velocidade -->
                                                <TextBlock Text="{Binding SpeedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                                <!-- ETA -->
                                                <TextBlock Text="{Binding EtaText, StringFormat='ETA: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3. ABA HISTÓRICO -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="History">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:HistoryView DataContext="{Binding HistoryVm}" />
            </Grid>

            <!-- 4. ABA FERRAMENTAS / DEPENDÊNCIAS -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Dependencies">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:DependenciesView DataContext="{Binding DependenciesVm}" />
            </Grid>

            <!-- 5. ABA CONFIGURAÇÕES -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:SettingsView DataContext="{Binding SettingsVm}" />
            </Grid>

            <!-- OVERLAY MODAL: EXPERIÊNCIA DE CONFIGURAÇÃO INICIAL (PREPARANDO O BAIXALL) -->
            <Grid Background="#C0000000"
                  Visibility="{Binding IsInitialSetupVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource SurfaceBgBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        MaxWidth="640"
                        Margin="32"
                        Padding="28"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <!-- Título e Subtítulo -->
                        <TextBlock Text="Preparando o BaixALL" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Alguns componentes são necessários para analisar e baixar vídeos. O BaixALL pode instalá-los automaticamente."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20" />

                        <!-- Lista Visual das Ferramentas Obrigatórias -->
                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding DependenciesVm.Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12" Background="{DynamicResource SurfaceBgBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                    <!-- Barra de progresso individual -->
                                                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Badge de Estado (✓ Instalado / ↓ Não instalado / etc) -->
                                                <Border Grid.Column="1" Padding="10,4" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#22107C41" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                    <Setter Property="Background" Value="#22D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Background" Value="#22D83B01" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateBadgeText}" FontWeight="Bold" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Barra de Progresso Geral -->
                        <StackPanel Visibility="{Binding DependenciesVm.IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <TextBlock Text="{Binding DependenciesVm.StatusText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding DependenciesVm.OverallProgress}" Maximum="100" Height="6" />
                        </StackPanel>

                        <!-- Mensagem de Erro se houver -->
                        <Border Background="#26D83B01" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding DependenciesVm.HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DependenciesVm.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" TextWrapping="Wrap" />
                        </Border>

                        <!-- Botões de Ação do Modal -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{Binding DependenciesVm.MainActionText}"
                                    Command="{Binding DependenciesVm.ExecuteMainActionCommand}"
                                    IsEnabled="{Binding DependenciesVm.IsBusy, Converter={StaticResource InverseBool}}"
                                    Padding="18,12" FontSize="14" FontWeight="Bold" Margin="0,0,12,0" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Lembrar mais tarde"
                                    Command="{Binding CloseSetupCommand}"
                                    IsEnabled="{Binding DependenciesVm.IsBusy, Converter={StaticResource InverseBool}}"
                                    Padding="14,12" FontSize="13" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
