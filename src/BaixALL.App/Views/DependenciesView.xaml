<UserControl x:Class="BaixALL.App.Views.DependenciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="880" HorizontalAlignment="Stretch">
            
            <!-- Título e Subtítulo Conforme Requisitos -->
            <TextBlock Text="Ferramentas" FontSize="28" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="Componentes utilizados pelo BaixALL para analisar e processar seus downloads."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Card de Visão Geral e Ações Globais -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status Geral -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Binários oficiais configurados e executados localmente no seu computador."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Indicador Geral de Prontidão -->
                        <Border Grid.Column="1" Padding="12,6" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#22107C41" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreAllInstalled}" Value="False">
                                            <Setter Property="Background" Value="#22D97706" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontWeight="Bold" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✓ Todas as ferramentas estão prontas." />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreAllInstalled}" Value="False">
                                                <Setter Property="Text" Value="▲ Componentes Pendentes" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Barra de Progresso Geral -->
                    <ProgressBar Grid.Row="1" Value="{Binding OverallProgress}" Maximum="100" Height="6" Margin="0,0,0,16"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- Mensagem de Erro se houver -->
                    <Border Grid.Row="2" Background="#26D83B01" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Padding="12" Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Tentar novamente"
                                    Command="{Binding InstallMissingCommand}" Margin="12,0,0,0" Padding="12,5" FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- Ações Globais: Verificar todas / Verificar atualizações / Instalar todas -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVis}}">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Verificar todas"
                                Command="{Binding CheckAllCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,12,0" Padding="18,9" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Verificar atualizações"
                                Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,12,0" Padding="16,9" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Instalar todas"
                                Command="{Binding InstallMissingCommand}"
                                Visibility="{Binding AreAllInstalled, Converter={StaticResource InverseBoolToVis}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Padding="16,9" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Título da Seção de Componentes -->
            <TextBlock Text="Componentes do Sistema" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

            <!-- Lista de Ferramentas com Cards Detalhados (yt-dlp, FFmpeg, ffprobe, Deno) -->
            <ItemsControl ItemsSource="{Binding Dependencies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Coluna da Esquerda: Nome, Status, Versão Detectada, Caminho Local -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />

                                        <!-- Badge de Status -->
                                        <Border Padding="10,3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#22107C41" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="NotInstalled">
                                                            <Setter Property="Background" Value="#22D97706" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Checking">
                                                            <Setter Property="Background" Value="#220078D4" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                            <Setter Property="Background" Value="#220078D4" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                                            <Setter Property="Background" Value="#22D83B01" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="NotInstalled">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Checking">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Versão Detectada -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Versão detectada: " FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                        <TextBlock Text="{Binding Version}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                    </StackPanel>

                                    <!-- Caminho Local -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Caminho local: " FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding LocalPath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Última Verificação -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Última checagem: " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding LastCheckedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    </StackPanel>

                                    <!-- Barra de Progresso de Download Individual -->
                                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,8,0,0"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Coluna da Direita: Ações Disponíveis (Verificar, Atualizar, Reinstalar) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    
                                    <!-- Botão Instalar (se não instalado ou erro) -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Instalar"
                                            Command="{Binding DataContext.InstallToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                            Margin="0,0,8,0" Padding="14,6" FontSize="12" />

                                    <!-- Botão Verificar -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Verificar"
                                            Command="{Binding DataContext.VerifyToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"
                                            Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Executar teste de validação do executável" />

                                    <!-- Botão Atualizar (se instalado) -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Atualizar"
                                            Command="{Binding DataContext.UpdateToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Atualizar para a versão mais recente oficial" />

                                    <!-- Botão Reinstalar (se instalado) -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Reinstalar"
                                            Command="{Binding DataContext.ReinstallToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                            Padding="12,6" FontSize="12" ToolTip="Baixar novamente e reinstalar o componente" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
