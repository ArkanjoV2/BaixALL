<UserControl x:Class="BaixALL.App.Views.DependenciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="820" HorizontalAlignment="Stretch">
            
            <TextBlock Text="Gerenciador de Dependências" FontSize="24" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="O BaixALL utiliza ferramentas oficiais para baixar, mesclar e processar vídeos e áudios com máxima fidelidade."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Card de Ação Principal -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- Barra de progresso geral -->
                    <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="8" Margin="0,0,0,16"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- Mensagem de Erro se houver -->
                    <Border Background="#33D83B01" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Instalar / Atualizar Todas as Ferramentas"
                                Command="{Binding InstallMissingCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,12,0" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Verificar Novamente"
                                Command="{Binding CheckCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Lista de Ferramentas -->
            <TextBlock Text="Componentes do Sistema" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Dependencies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Margin="0,0,12,0" />
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding LocalPath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    
                                    <!-- Progresso individual -->
                                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,8,0,0"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                                    <Border Padding="10,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#22107C41" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Background" Value="#22D97706" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
