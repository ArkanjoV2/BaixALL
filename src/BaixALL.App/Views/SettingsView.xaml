<UserControl x:Class="BaixALL.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="820" HorizontalAlignment="Stretch">
            
            <TextBlock Text="Configurações" FontSize="24" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="Gerencie preferências de download, interface e ferramentas do sistema."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,24" />

            <!-- Notificação de status de configuração -->
            <Border Background="#220078D4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" />
            </Border>

            <!-- Seção 1: Armazenamento e Downloads -->
            <TextBlock Text="Armazenamento e Downloads" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Pasta de Downloads -->
                    <TextBlock Text="Pasta padrão de downloads" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DownloadFolder, Mode=TwoWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Escolher pasta"
                                Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0" />
                    </Grid>

                    <!-- Downloads Simultâneos -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Downloads simultâneos" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Quantidade máxima de vídeos baixados em paralelo (padrão: 1)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding MaxConcurrentDownloads, Mode=TwoWay}" />
                    </Grid>

                    <!-- Auto Colar -->
                    <CheckBox Content="Detectar automaticamente link do YouTube na área de transferência"
                              IsChecked="{Binding AutoPasteClipboard, Mode=TwoWay}"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Seção 2: Personalização e Interface -->
            <TextBlock Text="Aparência" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tema da aplicação" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Escolha entre Claro, Escuro ou Seguir o padrão do Windows" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Seção 3: Ferramentas e Atualizações -->
            <TextBlock Text="Ferramentas e Manutenção" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Atualização do yt-dlp e dependências" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="O YouTube atualiza frequentemente seus formatos. Mantenha as ferramentas sempre atualizadas."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Verificar Atualizações"
                                Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,0,0,16" />

                    <!-- Ações Rápidas de Atualização -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Atualizar yt-dlp"
                                Command="{Binding UpdateDependencyCommand}" CommandParameter="yt-dlp" Margin="0,0,10,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Atualizar FFmpeg"
                                Command="{Binding UpdateDependencyCommand}" CommandParameter="FFmpeg" Margin="0,0,10,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Atualizar Deno"
                                Command="{Binding UpdateDependencyCommand}" CommandParameter="Deno" Margin="0,0,10,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,0,0,16" />

                    <!-- Pastas de Diagnóstico -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir Pasta de Logs"
                                Command="{Binding OpenLogsFolderCommand}" Margin="0,0,12,0" />

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Abrir Pasta de Ferramentas"
                                Command="{Binding OpenToolsFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Seção 4: Sobre -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding AppName}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Aplicativo Desktop Nativo para Windows com yt-dlp e FFmpeg."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        <TextBlock Text="100% Local • Sem telemetria • Sem servidores externos"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding AppVersion, StringFormat='v{0}'}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
