<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Windows 11 Light Fluent -->
    <Color x:Key="WindowBgColor">#F3F3F3</Color>
    <Color x:Key="SurfaceBgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#F9F9F9</Color>
    <Color x:Key="SurfaceBorderColor">#E0E0E0</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#CCCCCC</Color>

    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#616161</Color>
    <Color x:Key="TextMutedColor">#8A8A8A</Color>

    <Color x:Key="AccentColor">#0067B8</Color>
    <Color x:Key="AccentHoverColor">#0078D4</Color>
    <Color x:Key="AccentPressedColor">#005A9E</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>

    <Color x:Key="SuccessColor">#107C41</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    
    <!-- Header Degradê Equilibrado, Mais Elegante e Refinado (Azul Equilibrado) -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C3A60" Offset="0.0" />
        <GradientStop Color="#214571" Offset="0.5" />
        <GradientStop Color="#295282" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#1C3A60" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#2C588A" />
    <SolidColorBrush x:Key="HeaderTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderTextSecondaryBrush" Color="#FFFFFF" />
    
    <!-- Navegação e Destaques Visuais no Header Azul -->
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#325E93" />
    <SolidColorBrush x:Key="NavSelectedBgBrush" Color="#142E4E" />
    <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="#38BDF8" />
    
    <!-- Branding 'ALL' em Azul Ciano Elétrico -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#38BDF8" />
    
    <!-- Elementos Decorativos de Fundo da Home (Cinza Grafite Elegante e Visível) -->
    <SolidColorBrush x:Key="HomeDecorBrush" Color="#475569" />

    <!-- Barra de Rolagem (ScrollBar) Light Sofisticada -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#0284C7" />
</ResourceDictionary>
