<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Windows 11 Light Fluent -->
    <Color x:Key="WindowBgColor">#F3F3F3</Color>
    <Color x:Key="SurfaceBgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#F9F9F9</Color>
    <Color x:Key="SurfaceBorderColor">#E0E0E0</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#CCCCCC</Color>

    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#616161</Color>
    <Color x:Key="TextMutedColor">#8A8A8A</Color>

    <Color x:Key="AccentColor">#0067B8</Color>
    <Color x:Key="AccentHoverColor">#0078D4</Color>
    <Color x:Key="AccentPressedColor">#005A9E</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>

    <Color x:Key="SuccessColor">#107C41</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    
    <!-- Header Degradê Claro Refinado -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F4F8FC" Offset="0.65" />
        <GradientStop Color="#E8F1FC" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D0DFEE" />
    
    <!-- Navegação e Destaques Visuais -->
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#E5EFF9" />
    <SolidColorBrush x:Key="NavSelectedBgBrush" Color="#DAE9F7" />
    <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="{StaticResource AccentColor}" />
    
    <!-- Branding 'ALL' em Azul Tech -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#0284C7" />
    
    <!-- Elementos Decorativos de Fundo da Home (Baixa Opacidade) -->
    <SolidColorBrush x:Key="HomeDecorBrush" Color="#94A3B8" />
</ResourceDictionary>
