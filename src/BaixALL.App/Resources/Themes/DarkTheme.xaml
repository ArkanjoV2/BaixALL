<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Windows 11 Dark Fluent -->
    <Color x:Key="WindowBgColor">#1A1A1A</Color>
    <Color x:Key="SurfaceBgColor">#242424</Color>
    <Color x:Key="SurfaceHoverColor">#2E2E2E</Color>
    <Color x:Key="SurfaceBorderColor">#383838</Color>
    <Color x:Key="InputBgColor">#1E1E1E</Color>
    <Color x:Key="InputBorderColor">#404040</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A6A6A6</Color>
    <Color x:Key="TextMutedColor">#707070</Color>

    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#1084D9</Color>
    <Color x:Key="AccentPressedColor">#0067B8</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>

    <Color x:Key="SuccessColor">#107C41</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#D83B01</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    
    <!-- Header Degradê Mais Azul e Presente (Adaptado do Light para o Dark) -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1E33" Offset="0.0" />
        <GradientStop Color="#102844" Offset="0.5" />
        <GradientStop Color="#143254" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#0B1E33" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#1A3D66" />
    <SolidColorBrush x:Key="HeaderTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderTextSecondaryBrush" Color="#CBD5E1" />
    
    <!-- Navegação e Destaques Visuais -->
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#1A3F6B" />
    <SolidColorBrush x:Key="NavSelectedBgBrush" Color="#102947" />
    <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="#38BDF8" />
    
    <!-- Branding 'ALL' em Azul Tech Vibrante -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#38BDF8" />
    
    <!-- Elementos Decorativos de Fundo da Home (Tech Cyan Glow) -->
    <SolidColorBrush x:Key="HomeDecorBrush" Color="#38BDF8" />

    <!-- Barra de Rolagem (ScrollBar) Dark Moderna -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#334155" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#475569" />
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#38BDF8" />
</ResourceDictionary>
